# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── LLM endpoint (REQUIRED for `python -m agents.runtime.native_runner` and
#    `scripts/run_plan.py`) ──
# OpenAI-compatible chat-completions endpoint. Any provider works — Anthropic
# via a proxy, OpenAI, vLLM, Qwen, etc.
LLM_BASE_URL=https://your-llm-gateway.example.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=qwen

# ── Optional adapter knobs (read by agents/agent/relay_agent.py) ──
# Override which manifests directory to load cards from.
# RELAY_MANIFESTS=/abs/path/to/manifests
# Set to "0" to keep the previous conversation context across runs.
# RELAY_FRESH_CONV=1
# Multi-device setups: pin every adb call to one serial.
# RELAY_ANDROID_SERIAL=ABCDEF1234
# wait_for_reply capture_full: vertical swipe distance as fraction of screen
# height (clamped to 0.1–0.5). Higher = fewer VLM polls but more risk of
# missing text at the seam. Default 0.5.
# RELAY_CAPTURE_SCROLL_RATIO=0.5

# ── Path to adb executable (optional; auto-detected from PATH if not set) ──
# ADB=/path/to/adb
