<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LLM gateway access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Overlay status chip / ask_user panel ALSO grants the background
         activity-launch exemption we need to open target apps mid-run. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Resolve launch intents for arbitrary target apps (the capability
         catalog decides at runtime which apps a plan touches). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".RelayApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.RelayAgent"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: the in-lab LLM gateway is plain HTTP.
             Tighten to a networkSecurityConfig pinned to that host later. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".ExamplesActivity" android:exported="false" />
        <activity android:name=".LogActivity" android:exported="false" />
        <activity android:name=".RunDetailActivity" android:exported="false" />
        <activity android:name=".LegDetailActivity" android:exported="false" />
        <activity android:name=".RawLogActivity" android:exported="false" />
        <activity android:name=".LogDetailActivity" android:exported="false" />

        <service
            android:name=".RelayAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
