{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/RelayAgent/spec/v0.1/schema.json",
  "title": "RelayAgent Manifest",
  "description": "Normative JSON Schema for the RelayAgent SPEC v0.1. Cards are authored in YAML; this schema describes the equivalent JSON structure after parse.",

  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "card_version",
    "app_id",
    "app_name",
    "platforms",
    "locale",
    "embedded_agent",
    "provenance",
    "constraints"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$",
      "description": "Semver of the SPEC this card targets."
    },
    "card_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver of this card file. See SPEC §11."
    },
    "app_id": {
      "type": "string",
      "minLength": 1,
      "description": "Android package name or iOS bundle id."
    },
    "app_name": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["android", "ios", "harmonyos"] }
    },
    "locale": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
        "description": "BCP-47 language tag."
      }
    },
    "embedded_agent": { "$ref": "#/definitions/embedded_agent" },
    "provenance":     { "$ref": "#/definitions/provenance" },
    "constraints":    { "$ref": "#/definitions/constraints" }
  },

  "definitions": {

    "selector": {
      "description": "Reaches a single UI node. v0.1 selectors are single-field. See SPEC §6.1 and SPEC-OPEN-QUESTIONS OQ-10/11.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "accessibility_id": { "type": "string" },
        "resource_id":      { "type": "string" },
        "text":             { "type": "string" },
        "text_contains":    { "type": "string" },
        "screen_fraction": {
          "description": "Last-resort selector by screen-relative tap point.",
          "type": "object",
          "required": ["x_ratio", "y_ratio"],
          "properties": {
            "x_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "y_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "step": {
      "description": "One step of a tap_sequence. Exactly one of `tap`, `tap_label`, `tap_unless_present`, `swipe`, or `wait`.",
      "type": "object",
      "oneOf": [
        {
          "required": ["tap"],
          "properties": { "tap": { "$ref": "#/definitions/selector" } },
          "additionalProperties": false
        },
        {
          "required": ["tap_label"],
          "properties": {
            "tap_label": {
              "description": "Search the visible screen for a label, then tap it. Author SHOULD supply exactly one selector field (single-field convention, SPEC §6.1).",
              "type": "object",
              "minProperties": 1,
              "properties": {
                "text":                  { "type": "string" },
                "text_contains":         { "type": "string" },
                "text_or_desc":          { "type": "string" },
                "text_or_desc_contains": { "type": "string" },
                "accessibility_id":      { "type": "string" }
              },
              "patternProperties": { "^x_": {} },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["tap_unless_present"],
          "properties": {
            "tap_unless_present": {
              "description": "Tap `target` only if `probe` is not currently on screen. Used to make an entry step idempotent across cold/warm starts.",
              "type": "object",
              "required": ["probe", "target"],
              "properties": {
                "probe":  { "$ref": "#/definitions/selector" },
                "target": { "$ref": "#/definitions/selector" }
              },
              "patternProperties": { "^x_": {} },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["swipe"],
          "properties": {
            "swipe": {
              "enum": ["up", "down", "left", "right"],
              "description": "Scroll direction. action_planner compiles this to a scroll action; NativeEnv reverses up/down (card up == content moves up). See CLAUDE.md."
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["wait"],
          "properties": {
            "wait": {
              "type": "object",
              "oneOf": [
                { "required": ["ms"],    "properties": { "ms":    { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
                { "required": ["until"], "properties": { "until": { "$ref": "#/definitions/selector" }, "timeout_seconds": { "type": "number", "minimum": 0 } }, "additionalProperties": false }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },

    "entry": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "$ref": "#/definitions/entry_method" }
      },
      "patternProperties": { "^x_": {} },
      "additionalProperties": false
    },

    "entry_method": {
      "type": "object",
      "required": ["method", "steps"],
      "properties": {
        "method": { "const": "tap_sequence" },
        "steps": { "type": "array", "minItems": 0, "items": { "$ref": "#/definitions/step" } }
      },
      "patternProperties": { "^x_": {} },
      "additionalProperties": false
    },

    "invocation": {
      "type": "object",
      "required": ["input", "submit"],
      "properties": {
        "input": {
          "type": "object",
          "required": ["field"],
          "properties": {
            "field": { "$ref": "#/definitions/selector" }
          },
          "patternProperties": { "^x_": {} },
          "additionalProperties": false
        },
        "submit": {
          "type": "object",
          "required": ["trigger"],
          "properties": {
            "trigger": { "$ref": "#/definitions/selector" }
          },
          "patternProperties": { "^x_": {} },
          "additionalProperties": false
        }
      },
      "patternProperties": { "^x_": {} },
      "additionalProperties": false
    },

    "output": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": { "enum": ["none", "screen_text_extract", "accessibility_tree", "copy_button"] }
      },
      "patternProperties": { "^x_": {} },
      "additionalProperties": false
    },

    "capability": {
      "type": "object",
      "required": [
        "id",
        "description",
        "example_prompts",
        "executable",
        "handoff_to_user_required"
      ],
      "properties": {
        "id":              { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description":     { "type": "string", "minLength": 1 },
        "example_prompts": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "executable":               { "type": "boolean" },
        "handoff_to_user_required": { "type": "boolean" },
        "typical_latency_seconds":  { "type": "number", "minimum": 0 }
      },
      "patternProperties": { "^x_": {} },
      "additionalProperties": false
    },

    "embedded_agent": {
      "type": "object",
      "required": ["name", "description", "entry", "invocation", "capabilities"],
      "properties": {
        "name":         { "type": "string", "minLength": 1 },
        "description":  { "type": "string", "minLength": 1 },
        "entry":        { "$ref": "#/definitions/entry" },
        "invocation":   { "$ref": "#/definitions/invocation" },
        "output":       { "$ref": "#/definitions/output" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/capability" }
        }
      },
      "patternProperties": { "^x_": {} },
      "additionalProperties": false
    },

    "provenance": {
      "type": "object",
      "required": ["last_verified", "verified_app_version", "verified_os", "verification_method"],
      "properties": {
        "last_verified":        { "type": "string", "format": "date" },
        "verified_app_version": { "type": "string", "minLength": 1 },
        "verified_os":          { "type": "string", "pattern": "^(android|ios|harmonyos)-[0-9]+(?:\\.[0-9]+)*$" },
        "verified_device":      { "type": "string" },
        "verification_method":  { "enum": ["manual", "scripted", "community_reported"] },
        "evidence_url":         { "type": "string" },
        "x_device_metrics":     { "$ref": "#/definitions/x_device_metrics" }
      },
      "patternProperties": { "^x_": {} },
      "additionalProperties": false
    },

    "x_device_metrics": {
      "description": "Screen metrics of the verified device.",
      "type": "object",
      "required": ["resolution_px", "density_dpi"],
      "properties": {
        "resolution_px": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "density_dpi": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },

    "constraints": {
      "type": "object",
      "required": ["app_version_min", "network_required"],
      "properties": {
        "app_version_min": { "type": "string", "description": "Minimum supported app version; empty string means unspecified." },
        "app_version_max": { "type": "string" },
        "region": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "uniqueItems": true
        },
        "network_required": { "type": "boolean" },
        "known_issues":     { "type": "array", "items": { "type": "string" } }
      },
      "patternProperties": { "^x_": {} },
      "additionalProperties": false
    }
  }
}
